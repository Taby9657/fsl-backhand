generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH ====================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  googleId     String?  @unique
  appleId      String?  @unique
  pushToken    String?
  // Klasické přihlášení e-mailem. Null u účtů založených přes Google/Apple.
  passwordHash String?
  // Organizátor ligy. Nezávislé na hráčském profilu — supervisor ho mít nemusí.
  // Spravuje se z aplikace, ne přes env proměnnou a redeploy.
  isSupervisor Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  player    Player?
  referee   Referee?
  manager   Manager[]
  notifications Notification[]
  supervisorRequests SupervisorRequest[]
  carts     Cart[]
}

// ==================== TEAMS ====================

model Team {
  id        String   @id @default(uuid())
  name      String
  abbr      String   @db.VarChar(3)
  // Primární sada dresů. Sekundární je volitelná — někdo hraje pořád ve stejném.
  color          String   @default("#C9A140")
  colorSecondary String?
  logoUrl    String?
  venue      String?
  // Divizi a konferenci přiděluje supervisor až při rozlosování,
  // ne při registraci ani při schvalování týmu.
  division   String?
  conference String?
  /// Otevřený tým — skládá se z jednotlivců, nemá živého vedoucího a sestavu
  /// si hráči tvoří sami přihlášením. Viz fsl-pravidla-souteze.md.
  isOpen     Boolean  @default(false)
  /// Vypínač Pandy. Drží ho vedoucí; u isOpen týmů jen FULL.
  pandaMode  PandaMode @default(LEADER)
  regStatus   String   @default("APPROVED") // PENDING | APPROVED | REJECTED | APPEALING
  regNote     String?  // supervisor: důvod zamítnutí / poznámka ke schválení
  regAppeal   String?  // vedoucí: odvolání / zpětná reakce
  regAppealAt DateTime?
  createdAt DateTime @default(now())

  managers    Manager[]
  players     Player[]
  homeMatches Match[]   @relation("HomeTeam")
  awayMatches Match[]   @relation("AwayTeam")
  inviteCodes InviteCode[]
  payments    TeamPayment?
  cartItems   CartItem[]
  draftOffers DraftOffer[]
  seasons     TeamSeason[]
  playoffPrimaryFor   PlayoffChoice[] @relation("PlayoffPrimary")
  playoffSecondaryFor PlayoffChoice[] @relation("PlayoffSecondary")
  rosters             TeamRoster[]
  fines               Fine[]
}

model Manager {
  id        String   @id @default(uuid())
  userId    String
  teamId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model InviteCode {
  id        String    @id @default(uuid())
  code      String    @unique
  teamId    String
  usedCount Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

// ==================== PLAYERS ====================

model Player {
  id          String   @id @default(uuid())
  userId      String?  @unique
  teamId      String?
  firstName   String
  lastName    String
  jersey      Int
  position    String   @default("Útočník")
  birthdate   DateTime?
  phone       String?
  photoUrl    String?
  licensed      Boolean  @default(false)
  isSupervisor  Boolean  @default(false)

  /// Kdo mi smí psát: REQUESTS = cizí pošle žádost, NONE = nikdo cizí.
  dmPolicy      DmPolicy @default(REQUESTS)

  /// Kdy hráči odešel informativní e-mail "liga ti složila tým".
  /// Prázdno = ještě neodešel. Brání druhému rozeslání témuž člověku.
  teamOfferMailAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  team   Team? @relation(fields: [teamId], references: [id])

  goals        MatchEvent[] @relation("GoalScorer")
  assists      MatchEvent[] @relation("GoalAssist")
  penalties    MatchEvent[] @relation("PenaltyPlayer")
  lineupSlots  LineupPlayer[]
  mvpVotes     PostmatchData[] @relation("MvpPlayer")
  payment      PlayerPayment?
  draftProfile DraftProfile?
  playoffChoices PlayoffChoice[]
  rosters        TeamRoster[]
  matchPacks     MatchPack[]
  matchEntries   MatchEntry[]
  referralCode   ReferralCode?
  referredBy     ReferralUse?  @relation("PrivedenyHrac")
  cartItems      CartItem[]
  openEntries    OpenEntry[]
}

// ==================== REFEREES ====================

model Referee {
  id          String         @id @default(uuid())
  userId      String?        @unique
  firstName   String
  lastName    String
  phone       String?
  photoUrl    String?
  level       RefereeLevel   @default(C)
  status      RefereeStatus  @default(PENDING)
  /// Do soutěže smí jen od 18 let. Nullable kvůli rozhodčím z doby, kdy se
  /// datum nevyplňovalo; při registraci je povinné.
  birthdate   DateTime?
  /// Na fyzickou smlouvu a výplatu odměn. V registraci se neptáme.
  birthNo     String?
  address     String?
  city        String?
  zip         String?
  bankAccount String?
  bankCode    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  matches Match[]
  ratings RefRating[]
}

enum RefereeLevel {
  A
  B
  C
}

enum RefereeStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==================== MATCHES ====================

model Match {
  id         String      @id @default(uuid())
  homeTeamId String
  awayTeamId String
  refereeId  String?
  competition String     @default("FSL Liga")
  // Textová divize zůstává kvůli starým zápasům; nové se váží na strukturu
  division   String      @default("Divize A")
  /// Základní část vs. playoff. Rozhoduje o tom, která pravidla superlicence platí.
  phase      MatchPhase  @default(REGULAR)
  leagueId     String?
  conferenceId String?
  divisionId   String?
  season     String      @default("2025/26")
  round      Int?
  date       DateTime
  venue      String?
  homeScore       Int         @default(0)
  awayScore       Int         @default(0)
  status          MatchStatus @default(UPCOMING)
  // Zápasy platí hráči z balíčku startů (MatchPack, MatchEntry). Na zápase
  // proto žádný příznak zaplacení není a nepatří sem — kdo ho sem vrátí,
  // obejde kredit hráčů.
  /// Kontumace: id týmu, který se nedostavil nebo nesehnal sestavu.
  /// Zápas zůstává ve stavu DONE se skóre 5:0, aby se tabulka dopočítala
  /// sama; statistiky hráčů se z kontumovaného zápasu neberou.
  /// Schválně bez relace na Team — je to jen značka na zápase a další
  /// zpětná vazba na Team by kolidovala s HomeTeam/AwayTeam.
  forfeitTeamId   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  homeTeam  Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam  Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  referee   Referee? @relation(fields: [refereeId], references: [id])

  league     League?     @relation(fields: [leagueId],     references: [id], onDelete: SetNull)
  conference Conference? @relation(fields: [conferenceId], references: [id], onDelete: SetNull)
  divisionRef Division?  @relation(fields: [divisionId],   references: [id], onDelete: SetNull)

  events       MatchEvent[]
  entries      MatchEntry[]
  fine         Fine?
  lineups      LineupSubmission[]
  postmatches  PostmatchData[]
  refRatings   RefRating[]

  @@index([season])
  @@index([status])
  @@index([season, status])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([refereeId])
  @@index([date])
  @@index([season, phase])
  @@index([leagueId])
  @@index([conferenceId])
  @@index([divisionId])
}

enum MatchPhase {
  REGULAR
  PLAYOFF
}

enum MatchStatus {
  UPCOMING
  LIVE
  DONE
  CANCELLED
}

model MatchEvent {
  id         String         @id @default(uuid())
  matchId    String
  type       MatchEventType
  minute     Int
  period     Int            @default(1)
  teamId     String?
  scorerId   String?
  assistId   String?
  penaltyId  String?
  penaltyType String?
  createdAt  DateTime       @default(now())

  match   Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  scorer  Player? @relation("GoalScorer", fields: [scorerId], references: [id])
  assist  Player? @relation("GoalAssist", fields: [assistId], references: [id])
  penalty Player? @relation("PenaltyPlayer", fields: [penaltyId], references: [id])

  @@index([matchId])
  @@index([scorerId])
}

enum MatchEventType {
  GOAL
  PENALTY
  SHOOTOUT_GOAL
  SHOOTOUT_MISS
  PERIOD_END
  MATCH_END
}

model LineupSubmission {
  id        String   @id @default(uuid())
  matchId   String
  teamId    String
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())

  match   Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  players LineupPlayer[]

  @@unique([matchId, teamId])
}

model LineupPlayer {
  id           String  @id @default(uuid())
  lineupId     String
  playerId     String
  isGoalkeeper Boolean @default(false)
  isCaptain    Boolean @default(false)
  jerseyOverride Int?
  /// Doplněn až za běhu zápasu (pozdní příchod). Zůstává vidět v zápise.
  addedLate    Boolean   @default(false)
  addedAt      DateTime?

  lineup LineupSubmission @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  player Player           @relation(fields: [playerId], references: [id])

  @@unique([lineupId, playerId])
}

model PostmatchData {
  id           String   @id @default(uuid())
  matchId      String
  teamId       String
  refRating    Int?
  refNote      String?
  opponentMvpId String?
  actionVideoUrl String?
  actionDesc   String?
  submitted    Boolean  @default(false)
  submittedAt  DateTime?
  createdAt    DateTime @default(now())

  match       Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  opponentMvp Player? @relation("MvpPlayer", fields: [opponentMvpId], references: [id])

  @@unique([matchId, teamId])
}

model RefRating {
  id        String   @id @default(uuid())
  matchId   String
  refereeId String
  teamId    String
  rating    Int
  createdAt DateTime @default(now())

  match   Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  referee Referee @relation(fields: [refereeId], references: [id])

  @@unique([matchId, teamId])
}

// ==================== SOUTĚŽNÍ STRUKTURA ====================
//
// Sezóna může mít víc lig (max 10, rozlišených úrovní). Liga může mít
// konference (max 2) a konference divize (max 2) — obojí volitelně, takže
// první ročník může být jedna liga bez dalších vrstev.
//
// Zařazení týmu se drží na sezónu (TeamSeason), aby postup nebo sestup
// nepřepsal loňské tabulky a statistiky.

model League {
  id        String   @id @default(uuid())
  season    String
  name      String
  /// 1 = nejvyšší úroveň. Používá se k řazení.
  level     Int      @default(1)
  createdAt DateTime @default(now())

  conferences Conference[]
  teamSeasons TeamSeason[]
  matches     Match[]

  @@unique([season, name])
  @@index([season, level])
}

model Conference {
  id       String @id @default(uuid())
  leagueId String
  name     String

  league      League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  divisions   Division[]
  teamSeasons TeamSeason[]
  matches     Match[]

  @@unique([leagueId, name])
}

model Division {
  id           String @id @default(uuid())
  conferenceId String
  name         String

  conference  Conference   @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  teamSeasons TeamSeason[]
  matches     Match[]

  @@unique([conferenceId, name])
}

/// Přihláška týmu do sezóny.
///
/// Vzniká při registraci týmu, kdy ještě není zařazený do žádné ligy —
/// zařazení dělá supervisor až při rozlosování. Proto je leagueId volitelné.
/// Tým se do každé sezóny přihlašuje znovu, nepřenáší se automaticky.
model TeamSeason {
  id           String   @id @default(uuid())
  teamId       String
  season       String
  leagueId     String?
  conferenceId String?
  divisionId   String?
  createdAt    DateTime @default(now())

  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  league     League?     @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  conference Conference? @relation(fields: [conferenceId], references: [id], onDelete: SetNull)
  division   Division?   @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  @@unique([teamId, season])
  @@index([season, leagueId])
}

// ==================== PAYMENTS ====================

model TeamPayment {
  id             String        @id @default(uuid())
  teamId         String        @unique
  season         String        @default("2025/26")
  amount         Int           @default(3000)
  status         PaymentStatus @default(PENDING)
  /// Kolik uz na registraci prislo v sezone `season` (viz PlayerPayment.licPaidAmount).
  paidAmount     Int           @default(0)
  paidAt         DateTime?
  method         String?
  stripeId       String?
  sessionId      String?       // rozpracovaná Stripe Checkout session
  variableSymbol String?       @unique
  /// Poslední připomínka nezaplacené registrace (viz PlayerPayment.upominkaAt).
  upominkaAt     DateTime?
  upominekPoslano Int      @default(0)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model PlayerPayment {
  id             String        @id @default(uuid())
  playerId       String        @unique
  season         String        @default("2025/26")
  licFee         Int           @default(300)
  licStatus      PaymentStatus @default(PENDING)
  licPaidAt      DateTime?
  licMethod      String?
  /// Kolik uz na licenci prislo. Castecna platba se pricita, PAID se nastavi az pri pokryti licFee.
  licPaidAmount  Int           @default(0)
  superLic       Boolean       @default(false)
  superFee       Int           @default(300)
  superStatus    PaymentStatus @default(PENDING)
  superPaidAt    DateTime?
  /// Kolik uz na superlicenci prislo (viz licPaidAmount).
  superPaidAmount Int          @default(0)
  stripeId       String?
  licSessionId   String?  // rozpracovaná Checkout session – licence
  superSessionId String?  // rozpracovaná Checkout session – superlicence
  variableSymbol      String?  @unique // licence (prefix 1)
  superVariableSymbol String?  @unique // superlicence (prefix 2)
  /// Kdy odešla poslední připomínka a kolikátá to byla. Podle počtu se
  /// pozná, která fáze plánu přijde na řadu — viz `services/upominky.js`.
  upominkaAt          DateTime?
  upominekPoslano     Int       @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

// Záznamy o zpracovaných bankovních transakcích (zabraňuje duplicitám)
model BankTransaction {
  id             String   @id @default(uuid())
  transactionId  String   @unique  // ID transakce z Fio API
  amount         Int
  variableSymbol String?
  senderName     String?
  senderAccount  String?
  date           DateTime
  matched        Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  // Kód se ukládá jako hash — z databáze ho nikdo nepřečte.
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model SeasonTransition {
  id          String                  @id @default(uuid())
  newSeason   String
  scheduledAt DateTime
  status      SeasonTransitionStatus  @default(PENDING_CONFIRM)
  createdById String
  createdAt   DateTime                @default(now())
  confirmedAt DateTime?
  executedAt  DateTime?
  // Poslední upozornění, že přechod blokují neodehrané zápasy — ať se nespamuje
  blockedNotifiedAt DateTime?
  result      String?

  @@index([status, scheduledAt])
}

enum SeasonTransitionStatus {
  PENDING_CONFIRM
  CONFIRMED
  EXECUTED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
  /// Peníze šly zpátky plátci a plnění se zrušilo. Odlišené od WAIVED:
  /// odpuštěná platba se nikdy nevybrala, vrácená ano.
  REFUNDED
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  screen    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}

// ==================== HIGHLIGHTS ====================

model RoundHighlight {
  id        String   @id @default(uuid())
  round     Int?
  title     String
  body      String
  imageUrl  String?
  videoUrl  String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== DRAFT ====================

/// Nastavení ligy. Jediný řádek s pevným id "singleton".
///
/// Aktuální sezóna se dřív odvozovala ze sezóny posledního založeného zápasu,
/// takže ji určovala testovací data a měnit se dala jen přechodem sezóny.
/// Teď je uložená natvrdo a supervisor ji umí přepnout.
model Settings {
  id            String   @id @default("singleton")
  currentSeason String?
  updatedAt     DateTime @updatedAt

  /// Zdraví párování bankovních převodů.
  ///
  /// Do 10. 9. 2026 se selhání jen zalogovalo do konzole Railway. Když
  /// `FIO_API_TOKEN` chyběl, převody se od 28. 8. nepárovaly **jedenáct dní**
  /// a nikdo se to nedozvěděl — lidem peníze odešly a licence zůstaly
  /// nezaplacené. Tyhle čtyři sloupce jsou proto, aby ticho nebylo možné.
  bankSyncLastOkAt    DateTime?
  bankSyncLastErrorAt DateTime?
  bankSyncLastError   String?
  /// Kolikrát po sobě párování selhalo. Nula = poslední běh prošel.
  bankSyncFailStreak  Int       @default(0)

  /// Kdy naposledy odešel status náboru (každé 2 h od 8:00 do 22:00).
  ///
  /// Drží se v databázi, ne v paměti procesu: restart Railway je běžná věc
  /// a v paměti by se zapomnělo, že status už šel — majiteli by chodily dva
  /// stejné e-maily za sebou. Slouží zároveň jako hranice pro krátký
  /// report („co přibylo od posledně"). Viz `services/statusNaboru.js`.
  statusNaboruPoslanoAt DateTime?

  /// Cíl registrací na jeden konkrétní den a den, na který platí
  /// (`2026-09-20` v pražském čase).
  ///
  /// Stanoví se ve večerním reportu jako sedmidenní průměr + 20 %. Den se
  /// ukládá spolu s číslem schválně: bez něj by nedotažený včerejší cíl
  /// tiše platil dál a ráno by se proti němu měřil nový den.
  statusNaboruCil    Int?
  statusNaboruCilDen String?
}

/// Soupiska týmu na sezónu — kdo za tým smí nastupovat.
///
/// Kmenový tým má `isHome = true` a hráč ho má nejvýš jeden. Další řádky jsou
/// hostování, na která je potřeba superlicence. Dohromady nejvýš 3 týmy
/// na sezónu. Vedoucí pak do sestavy vybírá právě a jen z téhle soupisky.
model TeamRoster {
  id        String   @id @default(uuid())
  playerId  String
  teamId    String
  season    String
  isHome    Boolean  @default(false)
  /// Brankář, nebo hráč do pole. Drží se na soupisce, ne na hráči —
  /// `Player.position` je volný text (dva různé slovníky vedle sebe,
  /// výchozí „Útočník") a tentýž člověk může být v jednom týmu gólman
  /// a ve druhém hráč do pole. Rozhoduje tenhle sloupec.
  slot      RosterSlot @default(FIELD)
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId],   references: [id], onDelete: Cascade)

  @@unique([playerId, teamId, season])
  @@index([teamId, season])
  @@index([playerId, season])
  @@index([teamId, season, slot])
}

/// Místo na soupisce. Víc druhů nebude — sestava se skládá z 8 hráčů
/// do pole a jednoho brankáře, na nic jemnějšího se systém neptá.
enum RosterSlot {
  GOALKEEPER
  FIELD
}

/// Volba týmů pro playoff u hráče se superlicencí.
///
/// V základní části smí hrát až za 3 týmy. Do playoff si z těch, kde nasbíral
/// dost startů, vybere primární a volitelně sekundární tým. Za sekundární smí
/// nastoupit teprve ve chvíli, kdy primárnímu tým playoff skončí — nikdy tedy
/// nehraje dvě série naráz ani nerozhoduje vzájemný zápas svých týmů.
model PlayoffChoice {
  id              String   @id @default(uuid())
  playerId        String
  season          String
  primaryTeamId   String
  secondaryTeamId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  primary   Team   @relation("PlayoffPrimary",   fields: [primaryTeamId],   references: [id])
  secondary Team?  @relation("PlayoffSecondary", fields: [secondaryTeamId], references: [id])

  @@unique([playerId, season])
  @@index([season])
}

model DraftProfile {
  id        String   @id @default(uuid())
  playerId  String   @unique
  bio       String?
  pubSkill  String?
  position  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  videos DraftVideo[]
  offers DraftOffer[]
}

model DraftVideo {
  id        String   @id @default(uuid())
  profileId String
  url       String
  createdAt DateTime @default(now())

  profile DraftProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model DraftOffer {
  id        String           @id @default(uuid())
  profileId String
  teamId    String
  message   String?
  status    DraftOfferStatus @default(PENDING)
  isFirst   Boolean          @default(false)
  expiresAt DateTime
  createdAt DateTime         @default(now())

  profile DraftProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  team    Team         @relation(fields: [teamId], references: [id])

  @@unique([profileId, teamId])
  @@index([status])
  @@index([expiresAt])
}

enum DraftOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

// ==================== SUPERVISOR REQUESTS ====================

/// Zpráva supervisorovi z webu — dotaz, hlášení chyby, cokoli.
///
/// `email` je kontakt na odesílatele. U přihlášeného se bere z účtu, ale
/// ukládá se i tak: účet může být smazaný (`userId` je `SetNull`) a bez
/// adresy by zůstala zpráva, na kterou není komu odpovědět.
///
/// `page` je adresa stránky, ze které se zpráva odeslala. U hlášení chyby
/// je to ta nejdůležitější informace a člověk ji sám nenapíše.
model SupervisorRequest {
  id        String        @id @default(uuid())
  type      RequestType
  userId    String?
  teamId    String?
  matchId   String?
  email     String?
  page      String?
  body      String
  note      String?
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum RequestType {
  MATCH_TRANSCRIPT
  PLAYER_DISPUTE
  LICENSE_ISSUE
  OTHER
  WEB_BUG
  REGISTRATION
  PAYMENT
  ROSTER
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
}


// ==================== BALÍČKY ZÁPASŮ ====================
//
// Zápasy si platí hráč, ne tým. Kupuje si balíček startů a odehraný zápas
// z něj jeden odečte. Balíček patří hráči, ne týmu — kdo hostuje ve třech
// týmech, čerpá pořád z jednoho pytle.
//
// Odečítá se dvoufázově, jako u platební karty: zařazení do sestavy start
// **rezervuje**, odehraný zápas ho **zúčtuje**, zrušený nebo kontumovaný
// zápas ho **vrátí**. Bez rezervace by hráč s jedním zaplaceným zápasem
// mohl být naráz v sestavě tří.

/// Koupený balíček startů.
///
/// Kredit vzniká teprve při `status = PAID` — rozdělaná Checkout session
/// ani částečná platba hráči hrát nedovolí.
model MatchPack {
  id        String   @id @default(uuid())
  playerId  String
  season    String
  /// Kolik startů balíček obsahoval při koupi (1 / 3 / 7 / 12 / 16).
  size      Int
  /// Kolik z něj ještě zbývá. Rezervace snižuje, uvolnění vrací.
  remaining Int
  /// Do které sezóny balíček platí. `null` = bez omezení — nevyužité starty
  /// se přenášejí do playoff i do dalších sezón. Sloupec tu je proto, aby
  /// šlo platnost omezit bez migrace, kdyby se to ukázalo jako závazek,
  /// který nikdy nezmizí z účetnictví.
  validUntil String?
  /// Konečná cena, jak ji hráč zaplatil. Liga není plátce DPH.
  price     Int

  status         PaymentStatus @default(PENDING)
  paidAmount     Int           @default(0)
  paidAt         DateTime?
  method         String?
  stripeId       String?
  sessionId      String?
  variableSymbol String?       @unique
  createdAt      DateTime      @default(now())

  /// Balíček zdarma za přivedení nového hráče.
  isReward Boolean @default(false)

  player  Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  entries MatchEntry[]
  reward  ReferralUse?

  @@index([playerId, season])
  @@index([playerId, season, status])
}

/// Jeden start hráče v jednom zápase — rezervovaný, zúčtovaný, nebo vrácený.
///
/// Unikát [playerId, matchId] hlídá, aby se za jeden zápas nestrhlo dvakrát.
model MatchEntry {
  id        String      @id @default(uuid())
  playerId  String
  matchId   String
  teamId    String
  packId    String?
  status    EntryStatus @default(RESERVED)
  createdAt DateTime    @default(now())
  settledAt DateTime?

  player Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  match  Match      @relation(fields: [matchId],  references: [id], onDelete: Cascade)
  pack   MatchPack? @relation(fields: [packId],   references: [id], onDelete: SetNull)

  @@unique([playerId, matchId])
  @@index([matchId, status])
  @@index([playerId, status])
}

enum EntryStatus {
  RESERVED
  SPENT
  RELEASED
}


// ==================== DOPORUČENÍ ====================
//
// Každý hráč si ve svém účtu vygeneruje kód. Když s ním do ligy přijde nový
// hráč, zaplatí registraci a koupí si balíček od tří zápasů výš, dostane
// ten, kdo ho přivedl, **jeden zápas zdarma**. Nový hráč může jít do
// libovolného týmu — odměna není vázaná na to, že spolu budou hrát.

/// Doporučovací kód hráče. Jeden na hráče, platí napořád.
model ReferralCode {
  id        String   @id @default(uuid())
  code      String   @unique
  playerId  String   @unique
  createdAt DateTime @default(now())

  player Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  uses   ReferralUse[]
}

/// Uplatnění kódu novým hráčem.
///
/// Vzniká ve chvíli, kdy nový hráč kód zadá, ale odměna se vyplácí teprve
/// tehdy, když si koupí balíček od tří zápasů výš. Unikát na `newPlayerId`
/// hlídá, že jeden člověk může být „přivedený" jen jednou.
model ReferralUse {
  id          String    @id @default(uuid())
  codeId      String
  newPlayerId String    @unique
  rewardPackId String?  @unique
  rewardedAt  DateTime?
  createdAt   DateTime  @default(now())

  code       ReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  newPlayer  Player       @relation("PrivedenyHrac", fields: [newPlayerId], references: [id], onDelete: Cascade)
  rewardPack MatchPack?   @relation(fields: [rewardPackId], references: [id], onDelete: SetNull)

  @@index([codeId])
}

/// Pokuta za kontumaci. Plochá částka daná ceníkem — nezávisí na tom, kolik
/// hráčů se do sestavy přihlásilo, jinak by tým, kterému se nepřihlásil nikdo,
/// nezaplatil nic, přestože zápas zmařil nejvíc.
///
/// Předepisuje se týmu, který se nedostavil nebo nesehnal sestavu, a platí
/// ji vedoucí. Hráčům toho týmu zároveň propadnou starty z balíčku
/// (`kredit.vyresKontumaci`), takže trest má dvě části: hráči přijdou
/// o zápas, tým o peníze za hřiště a rozhodčího, které nikdo neodehrál.
///
/// Plochá částka je tu schválně. Kdyby se pokuta počítala z propadlých
/// startů, tým, kterému se do sestavy nikdo nepřihlásil, by nezaplatil nic —
/// tedy přesně ten, kdo zápas zmařil nejvíc.
///
/// Dokud je nezaplacená, rozhodčí týmu další zápas nespustí.
model Fine {
  id      String @id @default(uuid())
  teamId  String
  /// Jedna kontumace = jedna pokuta.
  matchId String @unique
  season  String
  amount  Int    @default(3000)
  reason  String

  status         PaymentStatus @default(PENDING)
  paidAmount     Int           @default(0)
  paidAt         DateTime?
  method         String?
  stripeId       String?
  sessionId      String?
  /// Variabilní symbol pro převod (prefix 5).
  variableSymbol String?       @unique
  createdAt      DateTime      @default(now())

  team  Team  @relation(fields: [teamId],  references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@index([season])
}

// ==================== KOŠÍK ====================

/// Co všechno jde koupit v jedné platbě.
///
/// Pokuta za kontumaci tu schválně **není**. Blokuje týmu další zápas, takže
/// se musí zaplatit hned a zvlášť — kdyby čekala v košíku na to, až si někdo
/// vybere balíček, stála by liga zápas.
/// Balík „Virtuální vedoucí" — jak se jednotlivec dostane do soutěže, když
/// nemá tým. Startovné 500 Kč + hráčská licence 300 Kč, účtováno jako jedna
/// položka za 800 Kč.
///
/// **Licence se drží rozepsaná zvlášť**, protože se nesmí zaplatit dvakrát:
/// kdo už ji na sezónu má, platí jen 500 a `licFee` je nula. Kdo ji nemá,
/// zaplatí 800 a zaúčtování balíku mu licenci rovnou vystaví.
///
/// Zařazení do otevřeného týmu, pořadník a dvojice tenhle model **neřeší** —
/// hráče zařazuje supervisor ve Správě hráčů. Až bude pořadník hotový
/// (`fsl-otevrene-tymy-navrh.md`), přibudou sem `teamId`, `pairCode`
/// a vlastní stav; tohle je ta část, která umí vybrat peníze.
model OpenEntry {
  id       String @id @default(uuid())
  playerId String
  season   String
  /// Brankář se musí přihlásit jako brankář — `Player.position` defaultuje
  /// na „Útočník", takže se na něj spolehnout nedá a tým bez dvou gólmanů
  /// nevznikne.
  slot     RosterSlot @default(FIELD)

  entryFee Int @default(500)
  licFee   Int @default(300)

  status     PaymentStatus @default(PENDING)
  paidAmount Int           @default(0)
  paidAt     DateTime?
  method     String?
  stripeId   String?
  createdAt  DateTime      @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season])
  @@index([season, status])
}

enum CartItemKind {
  PLAYER_LICENSE
  SUPER_LICENSE
  MATCH_PACK
  TEAM_REG
  /// Balík „Virtuální vedoucí" — vstup jednotlivce do otevřeného týmu.
  OPEN_ENTRY
}

/// Košík: víc poplatků, jedna platba.
///
/// Důvod jsou peníze. Stripe si u každé transakce bere **1,5 % + 6,50 Kč**;
/// ta pevná část se platí za každou platbu zvlášť, takže licence a balíček
/// koupené odděleně stojí ligu o 6,50 Kč víc než totéž v jedné platbě.
/// U převodu je úspora ještě větší — jeden variabilní symbol se spáruje
/// jednou a stojí nulu.
///
/// Otevřený košík je vždycky nejvýš jeden na uživatele (`status = PENDING`).
/// Zaplacené košíky zůstávají jako doklad, co v té platbě bylo.
model Cart {
  id       String        @id @default(uuid())
  userId   String
  season   String
  status   PaymentStatus @default(PENDING)
  /// Součet položek v okamžiku odeslání platby. Do té doby se dopočítává.
  amount   Int           @default(0)

  paidAmount Int       @default(0)
  paidAt     DateTime?
  method     String?
  stripeId   String?
  sessionId  String?
  /// Prefix 8. Prefixy 1–7 patří jednotlivým poplatkům, 4 je vysloužilá.
  variableSymbol String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId, status])
}

/// Jedna položka košíku.
///
/// Cena se ukládá při vložení, ne až při placení: kdyby liga mezitím změnila
/// ceník, člověk zaplatí to, co viděl. Kdo za položku platí, je vlastník
/// košíku; koho se týká, říká `playerId` / `teamId` — vedoucí tak může
/// zaplatit licenci svému hráči.
model CartItem {
  id       String       @id @default(uuid())
  cartId   String
  kind     CartItemKind
  playerId String?
  teamId   String?
  /// Jen u MATCH_PACK — velikost balíčku (1 / 3 / 7 / 12 / 16 / 20).
  packSize Int?
  amount   Int
  /// Do jaké sezóny položka patří. Nese ji položka, ne košík, protože tým
  /// a hráč můžou mít rozjetou jinou sezónu.
  season   String?

  createdAt DateTime @default(now())

  cart   Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  player Player? @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([cartId])
}

// ==================== MĚŘENÍ PŘIHLÁŠKY ====================

/// Průchod přihláškou — jeden řádek na jeden krok, kam člověk došel.
///
/// Vzniklo 16. 9. 2026. Za 24 hodin otevřelo `/registrace` 192 lidí a odeslaná
/// přihláška z toho nebyla ani jedna. Síťové logy Railway přitom ukázaly, že na
/// registrační cesty nepřišel **jediný POST** — nikdo tedy neodpadl na chybě
/// ani na validaci, lidé odcházeli někde uvnitř formuláře. Kde, nešlo zjistit:
/// krok žije v `?krok=` a Vercel Analytics na plánu Hobby dotaz nerozlišuje.
///
/// **Neukládá nic z formuláře.** Žádné jméno, e-mail, telefon ani datum
/// narození — jen náhodné id jednoho průchodu, roli, krok a čas. `navsteva`
/// vzniká v paměti otevřené stránky (`crypto.randomUUID()`), do prohlížeče se
/// neukládá a zavřením karty zaniká; nejde ji tedy spojit s člověkem ani
/// s jeho příští návštěvou. Proto to není osobní údaj a nepotřebuje souhlas.
/// Kdo sem někdy přidá cokoli z formuláře, tuhle vlastnost zruší.
///
/// Dvojice `navsteva` + `krok` je unikátní schválně: opakovaný návrat na krok
/// nový řádek nezaloží, takže „kolik lidí došlo na krok X" je prostý počet
/// řádků a trychtýř nezkreslí ten, kdo se vracel tam a zpátky.
model OnboardingStep {
  id       String  @id @default(uuid())
  /// Jeden průchod formulářem. Společné pro všechny kroky jedné návštěvy.
  navsteva String
  /// "player" / "manager" / "referee". Null na výběru role, kde ještě není.
  role     String?
  /// Slug kroku, jak ho zná web: role, kod, jmeno, dres, doplnky, tym,
  /// vzhled, ja, osobni, kontrola, hotovo.
  krok     String
  /// Zkrácená cesta hráče bez týmu — dva kroky místo čtyř.
  bezTymu  Boolean @default(false)

  /// Jak dlouho byl krok vidět, v sekundách. Null, dokud ho člověk neopustí —
  /// dopisuje se až při odchodu, takže rozdělaný krok ho nemá.
  sekundy   Int?
  /// Jak krok opustil: "klik" (šel dál v přihlášce), "jinam" (odešel jiným
  /// odkazem na webu), "zavrel". Null, když se odchod nestihl odeslat.
  odchod    String?
  /// Kam až doscrolloval, v procentech výšky stránky (0-100). Stránka, která
  /// se vejde na obrazovku, má 100.
  scroll    Int?
  /// Výška okna v px. Se `scroll` dohromady odpovídá na otázku, jestli vůbec
  /// uviděl karty s rolemi — na 667px displeji jsou tři ze čtyř mimo obrazovku.
  vyskaOkna Int?

  createdAt DateTime @default(now())

  @@unique([navsteva, krok])
  @@index([createdAt])
}


// ==================== CHAT A PANDA ====================
//
// Přidáno 21. 9. 2026. Zadání: `fsl-panda-ai-zadani-2026-09-21.md`.
//
// Dvě věci, které se tu nesmí ztratit:
//
// 1. **Týmová konverzace nemá sezónu.** `applyNewSeason()` maže soupisky,
//    chatu se nesmí dotknout — historie týmu přežívá ročník.
// 2. **Žádné relace na Player a Team.** Zprávy musí přežít smazání účtu
//    (ve skupinové konverzaci se jen odpojí od totožnosti), takže se tu
//    schválně nic nekaskáduje a drží se jen id.

enum ConversationKind {
  TEAM
  DIRECT
  PANDA
  SUPPORT
}
enum MessageKind {
  TEXT
  SYSTEM
  CARD
}
/// Nosný sloup: rozhoduje o umlčení i o tom, jestli se pošle e-mail.
/// PROVOZNI = sestava, platba, uzávěrka. Vypnout se nedá.
enum MessageClass {
  PROVOZNI
  SPOLECENSKA
}
enum ChatRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}
enum ReportTarget {
  MESSAGE
  PROFILE
}
enum ReportState {
  NEW
  REVIEWED
  DISMISSED
  ACTIONED
}
enum SanctionKind {
  MUTE
  NO_STRANGER_DM
  TEAM_CHAT_REMOVAL
  PHOTO_REMOVAL
}
enum PandaEventState {
  SENT
  SKIPPED
}
/// OFF = Panda mlčí úplně | LEADER = píše jen vedoucímu (výchozí)
/// FULL = píše celému týmu. U isOpen týmů je povolená jen FULL.
/// Na SUPPORT vlákna ani na losování tohle nemá vliv.
enum PandaMode {
  OFF
  LEADER
  FULL
}
/// REQUESTS = cizí člověk pošle žádost o chat, spoluhráči píšou rovnou.
/// NONE = "nechci zprávy od cizích". Varianta OPEN se záměrně nenabízí.
enum DmPolicy {
  REQUESTS
  NONE
}
enum PickSource {
  ROTATION
  DRAW
  MANUAL
}
enum PreviewState {
  DRAFT
  APPROVED
  PUBLISHED
  DISCARDED
  EXPIRED
}
model Conversation {
  id            String           @id @default(uuid())
  kind          ConversationKind
  teamId        String?          // jen TEAM — bez sezóny, chat je trvalý
  ownerPlayerId String?          // jen SUPPORT a PANDA — čí vlákno to je
  createdAt     DateTime         @default(now())
  lastMessageAt DateTime         @default(now())

  /// "Čeká na ligu" je příznak na konverzaci, ne tabulka tiketů.
  /// Shodí ho odpověď supervisora, nic jiného se neklikne.
  waitingSupervisor Boolean   @default(false)
  /// Konec NÁSLEDUJÍCÍHO dne v Europe/Prague. Počítá se v pražském čase,
  /// ne v UTC — jinak zpráva z 23:50 padne o den vedle.
  dueAt             DateTime?
  escalCategory     String?
  escalReason       String?
  overdueNotifiedAt DateTime?

  @@unique([teamId])
  @@unique([ownerPlayerId, kind])
  @@index([waitingSupervisor, dueAt])
  @@index([lastMessageAt])
}

model ConversationMember {
  id             String    @id @default(uuid())
  conversationId String
  playerId       String
  isSupervisor   Boolean   @default(false)
  addedById      String?
  joinedAt       DateTime  @default(now())
  /// Odebraný člen ztrácí přístup k historii. Jeho zprávy ostatním zůstávají
  /// a provozní zprávy k zápasu mu chodí dál soukromě.
  removedAt      DateTime?
  lastReadAt     DateTime?
  /// Umlčí JEN společenské zprávy od Pandy.
  mutedSocial    Boolean   @default(false)

  @@unique([conversationId, playerId])
  @@index([playerId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  /// null = Panda. Fotka autora se sem NEKOPÍRUJE, drží se u hráče.
  authorPlayerId String?
  fromSupervisor Boolean      @default(false)
  kind           MessageKind  @default(TEXT)
  class          MessageClass @default(SPOLECENSKA)
  body           String
  payload        Json?
  replyToId      String?
  editedAt       DateTime?
  /// Smazaná zpráva mizí všem, ale text zůstává v databázi — jinak nejde
  /// posoudit nahlášení něčeho, co pisatel hned smazal.
  deletedAt      DateTime?
  deletedById    String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// Zatím výhradně obrázky. Žádná videa, žádné dokumenty.
model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String
  url       String
  thumbUrl  String
  mime      String
  bytes     Int
  width     Int
  height    Int
  createdAt DateTime @default(now())

  @@index([messageId])
}

model MessageReaction {
  messageId String
  playerId  String
  emoji     String
  createdAt DateTime @default(now())

  @@id([messageId, playerId, emoji])
  @@index([messageId])
}

/// Žádost o chat: jedna zpráva, víc jich poslat nejde.
model ChatRequest {
  id           String            @id @default(uuid())
  fromPlayerId String
  toPlayerId   String
  body         String
  status       ChatRequestStatus @default(PENDING)
  createdAt    DateTime          @default(now())

  @@unique([fromPlayerId, toPlayerId])
  @@index([toPlayerId, status])
}

/// Blokace platí mezi hráči, NIKDY vůči lize — na supervisora se dostane každý.
model ChatBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
}

model ChatReport {
  id         String       @id @default(uuid())
  target     ReportTarget @default(MESSAGE)
  messageId  String?      // null, když se hlásí profil
  reporterId String
  subjectId  String
  reason     String
  state      ReportState  @default(NEW)
  caseId     String?
  createdAt  DateTime     @default(now())

  @@unique([messageId, reporterId])
  @@index([state, createdAt])
}

/// Podklad, který sesbírá Panda. NEOBSAHUJE návrh trestu — o následku
/// rozhoduje člověk.
model ModerationCase {
  id        String      @id @default(uuid())
  subjectId String
  summary   String
  evidence  Json
  stats     Json
  state     ReportState @default(NEW)
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime    @default(now())

  @@index([state, createdAt])
}

/// Sankci smí založit jen supervisor. Panda tenhle nástroj nemá.
model ChatSanction {
  id        String       @id @default(uuid())
  playerId  String
  kind      SanctionKind
  teamId    String?      // jen u TEAM_CHAT_REMOVAL
  reason    String       // povinné, ukáže se i potrestanému
  until     DateTime?    // null = do odvolání
  createdBy String
  revokedAt DateTime?
  createdAt DateTime     @default(now())

  @@index([playerId, until])
}

/// Idempotence Pandiných zpráv. Vlastní tabulka schválně: vypnutá Panda
/// událost ZAHODÍ (SKIPPED) a zprávu nevyrobí — bez toho by po zapnutí
/// vysypala týden zameškaných zpráv naráz.
model PandaEvent {
  key       String          @id
  teamId    String?
  state     PandaEventState
  messageId String?
  createdAt DateTime        @default(now())

  @@index([teamId, createdAt])
}

/// Audit: co Panda udělala, s čím a jestli to šlo vrátit.
model PandaAction {
  id         String    @id @default(uuid())
  kind       String
  teamId     String?
  playerId   String?
  matchId    String?
  input      Json
  result     Json?
  ok         Boolean   @default(true)
  revertedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([teamId, createdAt])
}

/// Hraju / Nemůžu. Obecné, ne jen pro otevřené týmy — klubový vedoucí
/// ho využije stejně.
model MatchSignup {
  matchId   String
  playerId  String
  playing   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([matchId, playerId])
  @@index([matchId, playing])
}

/// Kdo píše zápis. Každý pokus je vlastní řádek — losování musí jít po
/// zápase dohledat, jinak se z losu stane výběr.
model MatchScorekeeper {
  id            String     @id @default(uuid())
  matchId       String
  teamId        String
  playerId      String
  source        PickSource
  drawNo        Int        @default(0)
  candidates    Json
  excluded      Json?
  requestedById String?
  assignedAt    DateTime   @default(now())
  replacedAt    DateTime?
  replaceReason String?

  @@index([matchId, teamId])
}

/// Podklad k preview od supervizora — volný text z vlákna s Pandou.
model MatchNote {
  id        String   @id @default(uuid())
  matchId   String
  authorId  String
  body      String
  usedInId  String?
  createdAt DateTime @default(now())

  @@index([matchId, createdAt])
}

/// Jeden text pro oba týmy, ne dvě verze. Nesmí sáhnout na MatchSignup —
/// kdo se nepřihlásil, je vnitřní věc týmu.
model MatchPreview {
  id          String       @id @default(uuid())
  matchId     String       @unique
  body        String
  sources     Json
  state       PreviewState @default(DRAFT)
  approvedBy  String?
  approvedAt  DateTime?
  publishedAt DateTime?
  expiresAt   DateTime
  createdAt   DateTime     @default(now())

  @@index([state, expiresAt])
}
