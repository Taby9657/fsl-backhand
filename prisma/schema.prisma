generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH ====================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  googleId     String?  @unique
  appleId      String?  @unique
  pushToken    String?
  // Klasické přihlášení e-mailem. Null u účtů založených přes Google/Apple.
  passwordHash String?
  // Organizátor ligy. Nezávislé na hráčském profilu — supervisor ho mít nemusí.
  // Spravuje se z aplikace, ne přes env proměnnou a redeploy.
  isSupervisor Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  player    Player?
  referee   Referee?
  manager   Manager[]
  notifications Notification[]
  supervisorRequests SupervisorRequest[]
}

// ==================== TEAMS ====================

model Team {
  id        String   @id @default(uuid())
  name      String
  abbr      String   @db.VarChar(3)
  // Primární sada dresů. Sekundární je volitelná — někdo hraje pořád ve stejném.
  color          String   @default("#C9A140")
  colorSecondary String?
  logoUrl    String?
  venue      String?
  // Divizi a konferenci přiděluje supervisor až při rozlosování,
  // ne při registraci ani při schvalování týmu.
  division   String?
  conference String?
  /// Otevřený tým — skládá se z jednotlivců, nemá živého vedoucího a sestavu
  /// si hráči tvoří sami přihlášením. Viz fsl-pravidla-souteze.md.
  isOpen     Boolean  @default(false)
  regStatus   String   @default("APPROVED") // PENDING | APPROVED | REJECTED | APPEALING
  regNote     String?  // supervisor: důvod zamítnutí / poznámka ke schválení
  regAppeal   String?  // vedoucí: odvolání / zpětná reakce
  regAppealAt DateTime?
  createdAt DateTime @default(now())

  managers    Manager[]
  players     Player[]
  homeMatches Match[]   @relation("HomeTeam")
  awayMatches Match[]   @relation("AwayTeam")
  inviteCodes InviteCode[]
  payments    TeamPayment?
  draftOffers DraftOffer[]
  seasons     TeamSeason[]
  playoffPrimaryFor   PlayoffChoice[] @relation("PlayoffPrimary")
  playoffSecondaryFor PlayoffChoice[] @relation("PlayoffSecondary")
  rosters             TeamRoster[]
}

model Manager {
  id        String   @id @default(uuid())
  userId    String
  teamId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model InviteCode {
  id        String    @id @default(uuid())
  code      String    @unique
  teamId    String
  usedCount Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

// ==================== PLAYERS ====================

model Player {
  id          String   @id @default(uuid())
  userId      String?  @unique
  teamId      String?
  firstName   String
  lastName    String
  jersey      Int
  position    String   @default("Útočník")
  birthdate   DateTime?
  phone       String?
  photoUrl    String?
  licensed      Boolean  @default(false)
  isSupervisor  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  team   Team? @relation(fields: [teamId], references: [id])

  goals        MatchEvent[] @relation("GoalScorer")
  assists      MatchEvent[] @relation("GoalAssist")
  penalties    MatchEvent[] @relation("PenaltyPlayer")
  lineupSlots  LineupPlayer[]
  mvpVotes     PostmatchData[] @relation("MvpPlayer")
  payment      PlayerPayment?
  draftProfile DraftProfile?
  playoffChoices PlayoffChoice[]
  rosters        TeamRoster[]
  matchPacks     MatchPack[]
  matchEntries   MatchEntry[]
  referralCode   ReferralCode?
  referredBy     ReferralUse?  @relation("PrivedenyHrac")
}

// ==================== REFEREES ====================

model Referee {
  id          String         @id @default(uuid())
  userId      String?        @unique
  firstName   String
  lastName    String
  phone       String?
  photoUrl    String?
  level       RefereeLevel   @default(C)
  status      RefereeStatus  @default(PENDING)
  birthNo     String?
  address     String?
  city        String?
  zip         String?
  bankAccount String?
  bankCode    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  matches Match[]
  ratings RefRating[]
}

enum RefereeLevel {
  A
  B
  C
}

enum RefereeStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==================== MATCHES ====================

model Match {
  id         String      @id @default(uuid())
  homeTeamId String
  awayTeamId String
  refereeId  String?
  competition String     @default("FSL Liga")
  // Textová divize zůstává kvůli starým zápasům; nové se váží na strukturu
  division   String      @default("Divize A")
  /// Základní část vs. playoff. Rozhoduje o tom, která pravidla superlicence platí.
  phase      MatchPhase  @default(REGULAR)
  leagueId     String?
  conferenceId String?
  divisionId   String?
  season     String      @default("2025/26")
  round      Int?
  date       DateTime
  venue      String?
  homeScore       Int         @default(0)
  awayScore       Int         @default(0)
  status          MatchStatus @default(UPCOMING)
  homeFeePaid     Boolean     @default(false)
  /// Kolik uz na poplatek za tento zapas prislo (viz PlayerPayment.licPaidAmount).
  homeFeePaidAmount Int       @default(0)
  homeFeeStripeId String?
  homeFeeSessionId String?    // rozpracovaná Checkout session
  homeFeeReminderAt DateTime?  // kdy odešla upomínka na neuhrazený poplatek
  homeFeeVS       String?     @unique // variabilní symbol pro převod (prefix 4)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  homeTeam  Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam  Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  referee   Referee? @relation(fields: [refereeId], references: [id])

  league     League?     @relation(fields: [leagueId],     references: [id], onDelete: SetNull)
  conference Conference? @relation(fields: [conferenceId], references: [id], onDelete: SetNull)
  divisionRef Division?  @relation(fields: [divisionId],   references: [id], onDelete: SetNull)

  events       MatchEvent[]
  entries      MatchEntry[]
  lineups      LineupSubmission[]
  postmatches  PostmatchData[]
  refRatings   RefRating[]

  @@index([season])
  @@index([status])
  @@index([season, status])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([refereeId])
  @@index([date])
  @@index([season, phase])
  @@index([leagueId])
  @@index([conferenceId])
  @@index([divisionId])
}

enum MatchPhase {
  REGULAR
  PLAYOFF
}

enum MatchStatus {
  UPCOMING
  LIVE
  DONE
  CANCELLED
}

model MatchEvent {
  id         String         @id @default(uuid())
  matchId    String
  type       MatchEventType
  minute     Int
  period     Int            @default(1)
  teamId     String?
  scorerId   String?
  assistId   String?
  penaltyId  String?
  penaltyType String?
  createdAt  DateTime       @default(now())

  match   Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  scorer  Player? @relation("GoalScorer", fields: [scorerId], references: [id])
  assist  Player? @relation("GoalAssist", fields: [assistId], references: [id])
  penalty Player? @relation("PenaltyPlayer", fields: [penaltyId], references: [id])

  @@index([matchId])
  @@index([scorerId])
}

enum MatchEventType {
  GOAL
  PENALTY
  SHOOTOUT_GOAL
  SHOOTOUT_MISS
  PERIOD_END
  MATCH_END
}

model LineupSubmission {
  id        String   @id @default(uuid())
  matchId   String
  teamId    String
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())

  match   Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  players LineupPlayer[]

  @@unique([matchId, teamId])
}

model LineupPlayer {
  id           String  @id @default(uuid())
  lineupId     String
  playerId     String
  isGoalkeeper Boolean @default(false)
  isCaptain    Boolean @default(false)
  jerseyOverride Int?
  /// Doplněn až za běhu zápasu (pozdní příchod). Zůstává vidět v zápise.
  addedLate    Boolean   @default(false)
  addedAt      DateTime?

  lineup LineupSubmission @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  player Player           @relation(fields: [playerId], references: [id])

  @@unique([lineupId, playerId])
}

model PostmatchData {
  id           String   @id @default(uuid())
  matchId      String
  teamId       String
  refRating    Int?
  refNote      String?
  opponentMvpId String?
  actionVideoUrl String?
  actionDesc   String?
  submitted    Boolean  @default(false)
  submittedAt  DateTime?
  createdAt    DateTime @default(now())

  match       Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  opponentMvp Player? @relation("MvpPlayer", fields: [opponentMvpId], references: [id])

  @@unique([matchId, teamId])
}

model RefRating {
  id        String   @id @default(uuid())
  matchId   String
  refereeId String
  teamId    String
  rating    Int
  createdAt DateTime @default(now())

  match   Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  referee Referee @relation(fields: [refereeId], references: [id])

  @@unique([matchId, teamId])
}

// ==================== SOUTĚŽNÍ STRUKTURA ====================
//
// Sezóna může mít víc lig (max 10, rozlišených úrovní). Liga může mít
// konference (max 2) a konference divize (max 2) — obojí volitelně, takže
// první ročník může být jedna liga bez dalších vrstev.
//
// Zařazení týmu se drží na sezónu (TeamSeason), aby postup nebo sestup
// nepřepsal loňské tabulky a statistiky.

model League {
  id        String   @id @default(uuid())
  season    String
  name      String
  /// 1 = nejvyšší úroveň. Používá se k řazení.
  level     Int      @default(1)
  createdAt DateTime @default(now())

  conferences Conference[]
  teamSeasons TeamSeason[]
  matches     Match[]

  @@unique([season, name])
  @@index([season, level])
}

model Conference {
  id       String @id @default(uuid())
  leagueId String
  name     String

  league      League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  divisions   Division[]
  teamSeasons TeamSeason[]
  matches     Match[]

  @@unique([leagueId, name])
}

model Division {
  id           String @id @default(uuid())
  conferenceId String
  name         String

  conference  Conference   @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  teamSeasons TeamSeason[]
  matches     Match[]

  @@unique([conferenceId, name])
}

/// Přihláška týmu do sezóny.
///
/// Vzniká při registraci týmu, kdy ještě není zařazený do žádné ligy —
/// zařazení dělá supervisor až při rozlosování. Proto je leagueId volitelné.
/// Tým se do každé sezóny přihlašuje znovu, nepřenáší se automaticky.
model TeamSeason {
  id           String   @id @default(uuid())
  teamId       String
  season       String
  leagueId     String?
  conferenceId String?
  divisionId   String?
  createdAt    DateTime @default(now())

  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  league     League?     @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  conference Conference? @relation(fields: [conferenceId], references: [id], onDelete: SetNull)
  division   Division?   @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  @@unique([teamId, season])
  @@index([season, leagueId])
}

// ==================== PAYMENTS ====================

model TeamPayment {
  id             String        @id @default(uuid())
  teamId         String        @unique
  season         String        @default("2025/26")
  amount         Int           @default(8000)
  status         PaymentStatus @default(PENDING)
  /// Kolik uz na registraci prislo v sezone `season` (viz PlayerPayment.licPaidAmount).
  paidAmount     Int           @default(0)
  paidAt         DateTime?
  method         String?
  stripeId       String?
  sessionId      String?       // rozpracovaná Stripe Checkout session
  variableSymbol String?       @unique

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model PlayerPayment {
  id             String        @id @default(uuid())
  playerId       String        @unique
  season         String        @default("2025/26")
  licFee         Int           @default(250)
  licStatus      PaymentStatus @default(PENDING)
  licPaidAt      DateTime?
  licMethod      String?
  /// Kolik uz na licenci prislo. Castecna platba se pricita, PAID se nastavi az pri pokryti licFee.
  licPaidAmount  Int           @default(0)
  superLic       Boolean       @default(false)
  superFee       Int           @default(250)
  superStatus    PaymentStatus @default(PENDING)
  superPaidAt    DateTime?
  /// Kolik uz na superlicenci prislo (viz licPaidAmount).
  superPaidAmount Int          @default(0)
  stripeId       String?
  licSessionId   String?  // rozpracovaná Checkout session – licence
  superSessionId String?  // rozpracovaná Checkout session – superlicence
  variableSymbol      String?  @unique // licence (prefix 1)
  superVariableSymbol String?  @unique // superlicence (prefix 2)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

// Záznamy o zpracovaných bankovních transakcích (zabraňuje duplicitám)
model BankTransaction {
  id             String   @id @default(uuid())
  transactionId  String   @unique  // ID transakce z Fio API
  amount         Int
  variableSymbol String?
  senderName     String?
  senderAccount  String?
  date           DateTime
  matched        Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  // Kód se ukládá jako hash — z databáze ho nikdo nepřečte.
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model SeasonTransition {
  id          String                  @id @default(uuid())
  newSeason   String
  scheduledAt DateTime
  status      SeasonTransitionStatus  @default(PENDING_CONFIRM)
  createdById String
  createdAt   DateTime                @default(now())
  confirmedAt DateTime?
  executedAt  DateTime?
  // Poslední upozornění, že přechod blokují neodehrané zápasy — ať se nespamuje
  blockedNotifiedAt DateTime?
  result      String?

  @@index([status, scheduledAt])
}

enum SeasonTransitionStatus {
  PENDING_CONFIRM
  CONFIRMED
  EXECUTED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  screen    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}

// ==================== HIGHLIGHTS ====================

model RoundHighlight {
  id        String   @id @default(uuid())
  round     Int?
  title     String
  body      String
  imageUrl  String?
  videoUrl  String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== DRAFT ====================

/// Nastavení ligy. Jediný řádek s pevným id "singleton".
///
/// Aktuální sezóna se dřív odvozovala ze sezóny posledního založeného zápasu,
/// takže ji určovala testovací data a měnit se dala jen přechodem sezóny.
/// Teď je uložená natvrdo a supervisor ji umí přepnout.
model Settings {
  id            String   @id @default("singleton")
  currentSeason String?
  updatedAt     DateTime @updatedAt
}

/// Soupiska týmu na sezónu — kdo za tým smí nastupovat.
///
/// Kmenový tým má `isHome = true` a hráč ho má nejvýš jeden. Další řádky jsou
/// hostování, na která je potřeba superlicence. Dohromady nejvýš 3 týmy
/// na sezónu. Vedoucí pak do sestavy vybírá právě a jen z téhle soupisky.
model TeamRoster {
  id        String   @id @default(uuid())
  playerId  String
  teamId    String
  season    String
  isHome    Boolean  @default(false)
  /// Brankář, nebo hráč do pole. Drží se na soupisce, ne na hráči —
  /// `Player.position` je volný text (dva různé slovníky vedle sebe,
  /// výchozí „Útočník") a tentýž člověk může být v jednom týmu gólman
  /// a ve druhém hráč do pole. Rozhoduje tenhle sloupec.
  slot      RosterSlot @default(FIELD)
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId],   references: [id], onDelete: Cascade)

  @@unique([playerId, teamId, season])
  @@index([teamId, season])
  @@index([playerId, season])
  @@index([teamId, season, slot])
}

/// Místo na soupisce. Víc druhů nebude — sestava se skládá z 8 hráčů
/// do pole a jednoho brankáře, na nic jemnějšího se systém neptá.
enum RosterSlot {
  GOALKEEPER
  FIELD
}

/// Volba týmů pro playoff u hráče se superlicencí.
///
/// V základní části smí hrát až za 3 týmy. Do playoff si z těch, kde nasbíral
/// dost startů, vybere primární a volitelně sekundární tým. Za sekundární smí
/// nastoupit teprve ve chvíli, kdy primárnímu tým playoff skončí — nikdy tedy
/// nehraje dvě série naráz ani nerozhoduje vzájemný zápas svých týmů.
model PlayoffChoice {
  id              String   @id @default(uuid())
  playerId        String
  season          String
  primaryTeamId   String
  secondaryTeamId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  primary   Team   @relation("PlayoffPrimary",   fields: [primaryTeamId],   references: [id])
  secondary Team?  @relation("PlayoffSecondary", fields: [secondaryTeamId], references: [id])

  @@unique([playerId, season])
  @@index([season])
}

model DraftProfile {
  id        String   @id @default(uuid())
  playerId  String   @unique
  bio       String?
  pubSkill  String?
  position  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  videos DraftVideo[]
  offers DraftOffer[]
}

model DraftVideo {
  id        String   @id @default(uuid())
  profileId String
  url       String
  createdAt DateTime @default(now())

  profile DraftProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model DraftOffer {
  id        String           @id @default(uuid())
  profileId String
  teamId    String
  message   String?
  status    DraftOfferStatus @default(PENDING)
  isFirst   Boolean          @default(false)
  expiresAt DateTime
  createdAt DateTime         @default(now())

  profile DraftProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  team    Team         @relation(fields: [teamId], references: [id])

  @@unique([profileId, teamId])
  @@index([status])
  @@index([expiresAt])
}

enum DraftOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

// ==================== SUPERVISOR REQUESTS ====================

model SupervisorRequest {
  id        String        @id @default(uuid())
  type      RequestType
  userId    String?
  teamId    String?
  matchId   String?
  body      String
  note      String?
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum RequestType {
  MATCH_TRANSCRIPT
  PLAYER_DISPUTE
  LICENSE_ISSUE
  OTHER
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
}


// ==================== BALÍČKY ZÁPASŮ ====================
//
// Zápasy si platí hráč, ne tým. Kupuje si balíček startů a odehraný zápas
// z něj jeden odečte. Balíček patří hráči, ne týmu — kdo hostuje ve třech
// týmech, čerpá pořád z jednoho pytle.
//
// Odečítá se dvoufázově, jako u platební karty: zařazení do sestavy start
// **rezervuje**, odehraný zápas ho **zúčtuje**, zrušený nebo kontumovaný
// zápas ho **vrátí**. Bez rezervace by hráč s jedním zaplaceným zápasem
// mohl být naráz v sestavě tří.

/// Koupený balíček startů.
///
/// Kredit vzniká teprve při `status = PAID` — rozdělaná Checkout session
/// ani částečná platba hráči hrát nedovolí.
model MatchPack {
  id        String   @id @default(uuid())
  playerId  String
  season    String
  /// Kolik startů balíček obsahoval při koupi (1 / 3 / 7 / 12 / 16).
  size      Int
  /// Kolik z něj ještě zbývá. Rezervace snižuje, uvolnění vrací.
  remaining Int
  /// Do které sezóny balíček platí. `null` = bez omezení — nevyužité starty
  /// se přenášejí do playoff i do dalších sezón. Sloupec tu je proto, aby
  /// šlo platnost omezit bez migrace, kdyby se to ukázalo jako závazek,
  /// který nikdy nezmizí z účetnictví.
  validUntil String?
  /// Cena včetně DPH, jak ji hráč zaplatil.
  price     Int

  status         PaymentStatus @default(PENDING)
  paidAmount     Int           @default(0)
  paidAt         DateTime?
  method         String?
  stripeId       String?
  sessionId      String?
  variableSymbol String?       @unique
  createdAt      DateTime      @default(now())

  /// Balíček zdarma za přivedení nového hráče.
  isReward Boolean @default(false)

  player  Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  entries MatchEntry[]
  reward  ReferralUse?

  @@index([playerId, season])
  @@index([playerId, season, status])
}

/// Jeden start hráče v jednom zápase — rezervovaný, zúčtovaný, nebo vrácený.
///
/// Unikát [playerId, matchId] hlídá, aby se za jeden zápas nestrhlo dvakrát.
model MatchEntry {
  id        String      @id @default(uuid())
  playerId  String
  matchId   String
  teamId    String
  packId    String?
  status    EntryStatus @default(RESERVED)
  createdAt DateTime    @default(now())
  settledAt DateTime?

  player Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  match  Match      @relation(fields: [matchId],  references: [id], onDelete: Cascade)
  pack   MatchPack? @relation(fields: [packId],   references: [id], onDelete: SetNull)

  @@unique([playerId, matchId])
  @@index([matchId, status])
  @@index([playerId, status])
}

enum EntryStatus {
  RESERVED
  SPENT
  RELEASED
}


// ==================== DOPORUČENÍ ====================
//
// Každý hráč si ve svém účtu vygeneruje kód. Když s ním do ligy přijde nový
// hráč, zaplatí registraci a koupí si balíček od tří zápasů výš, dostane
// ten, kdo ho přivedl, **jeden zápas zdarma**. Nový hráč může jít do
// libovolného týmu — odměna není vázaná na to, že spolu budou hrát.

/// Doporučovací kód hráče. Jeden na hráče, platí napořád.
model ReferralCode {
  id        String   @id @default(uuid())
  code      String   @unique
  playerId  String   @unique
  createdAt DateTime @default(now())

  player Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  uses   ReferralUse[]
}

/// Uplatnění kódu novým hráčem.
///
/// Vzniká ve chvíli, kdy nový hráč kód zadá, ale odměna se vyplácí teprve
/// tehdy, když si koupí balíček od tří zápasů výš. Unikát na `newPlayerId`
/// hlídá, že jeden člověk může být „přivedený" jen jednou.
model ReferralUse {
  id          String    @id @default(uuid())
  codeId      String
  newPlayerId String    @unique
  rewardPackId String?  @unique
  rewardedAt  DateTime?
  createdAt   DateTime  @default(now())

  code       ReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  newPlayer  Player       @relation("PrivedenyHrac", fields: [newPlayerId], references: [id], onDelete: Cascade)
  rewardPack MatchPack?   @relation(fields: [rewardPackId], references: [id], onDelete: SetNull)

  @@index([codeId])
}
